# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://caixa:caixa@127.0.0.1:5432/fechamento"

# URL pública do sistema (usada nos links do e-mail)
APP_URL="http://localhost:3000"

# Fuso horário do restaurante (datas de negócio e horários exibidos)
APP_TIMEZONE="America/Sao_Paulo"

# Administrador criado pelo seed (troque a senha no primeiro acesso)
SEED_ADMIN_EMAIL="admin@restaurante.local"
SEED_ADMIN_PASSWORD="troque-esta-senha"

# E-mail: "smtp", "resend" ou "none" (desligado: o envio falha com aviso claro e pode ser reenviado depois)
EMAIL_PROVIDER="none"
EMAIL_FROM="Fechamento de Caixa <caixa@seudominio.com.br>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
